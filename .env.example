# Copy this file to .env (same folder as git_seance.py) and fill it in.
# .env is read automatically. Never commit it.

# --- Option A: local Gemma through Ollama (default, fully offline) ---
SEANCE_PROVIDER=ollama
SEANCE_MODEL=gemma3:4b
# SEANCE_OLLAMA=http://localhost:11434

# --- Option B: SoCLaaS (OpenAI-compatible gateway) ---
# SEANCE_PROVIDER=openai
# SEANCE_API_BASE=https://<soclaas-gateway>/v1
# SEANCE_API_KEY=paste-key-here
# SEANCE_MODEL=qwen3.6:35b

# Optional (Ollama): layers to put on the GPU. 0 forces CPU, e.g. if the CUDA
# runner crashes with "device kernel image is invalid" on an older driver.
# SEANCE_NUM_GPU=0
